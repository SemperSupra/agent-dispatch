  "acceptance_rungs": {
    "T0": "Freeze exact GHA reference predicates and local source identity.",
    "T1": "Build/materialize the candidate template without runtime support claim.",
    "T2": "Run the same passive census schema on the local candidate.",
    "T3": "Reproduce required primitive oracles.",
    "T4": "Reproduce representative GHA workload predicates.",
    "T5": "Prove create/start/restart/retire/rebuild reconciliation and zero residue.",
    "T6": "Execute one real ephemeral GARM/GitHub runner workload through the local provider.",
    "T7": "For sovereign-enhanced profiles only, independently prove each enhancement.",
    "T8": "Admit the exact template to workload placement with evidence refs and no inheritance."
  },
