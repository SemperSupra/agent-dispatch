ARG BASE=ubuntu:24.04
FROM ${BASE}
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq && apt-get install -qq -y --no-install-recommends linux-tools-common linux-tools-generic iproute2 ca-certificates coreutils procps && rm -rf /var/lib/apt/lists/*
COPY probe.sh /probe.sh
USER 65532:65532
ENTRYPOINT ["/bin/bash","/probe.sh"]
