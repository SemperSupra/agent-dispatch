# Public disposable two-kernel USB/IP HID qualification image.
ARG BASE=debian:trixie-slim
FROM ${BASE} AS builder
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq && apt-get install -qq -y --no-install-recommends \
  linux-image-amd64 initramfs-tools kmod usbip gcc libc6-dev golang-go \
  busybox-static cpio gzip zstd xz-utils && mkdir -p /out /tmp/root /tmp/merged
# R27-L exact R27-A provider source copied once, with only UART gate changed.
COPY experiments/pi-usb-fabric-r27/uart-ack/provider.init /tmp/provider.init
COPY experiments/pi-usb-fabric-r22/qmp-usbip-compose/usbip-guest-signing/consumer-a.init /tmp/consumer-a.init
COPY --from=udcsource experiments/pi-usb-fabric-r27/udc-admission/consumer-b.init /tmp/consumer-b.init
COPY experiments/pi-usb-fabric-r06/transport/hid_evdev_observer.c /tmp/evdev.c
RUN set -eux; \
  kernel="$(find /boot -maxdepth 1 -name 'vmlinuz-*' -type f | head -1)"; \
  test -n "$kernel"; version="${kernel#/boot/vmlinuz-}"; \
  cp "$kernel" /out/kernel; cp "/boot/config-$version" /out/kernel-config; \
  printf 'usbip_core\nusbip_host\nvhci_hcd\nusbip_vudc\nlibcomposite\ndummy_hcd\nusb_f_hid\nusbhid\nhid_generic\nevdev\ne1000\nvirtio\nvirtio_pci\nvirtio_ring\nvirtio_console\n' >> /etc/initramfs-tools/modules; \
  mkinitramfs -o /out/default-initrd "$version"; \
  unmkinitramfs /out/default-initrd /tmp/root; \
  if test -d /tmp/root/main; then cp -a /tmp/root/main/. /tmp/merged/; else cp -a /tmp/root/. /tmp/merged/; fi; \
  mkdir -p /tmp/merged/bin; cp /bin/busybox /tmp/merged/bin/busybox; \
  find /tmp/merged -type f -name '*.ko.zst' -exec zstd -d --rm -q {} +; \
  find /tmp/merged -type f -name '*.ko.xz' -exec xz -d {} +; \
  for name in usbip usbipd; do bin="$(command -v "$name")"; test -x "$bin"; \
    mkdir -p "/tmp/merged$(dirname "$bin")"; cp -L "$bin" "/tmp/merged$bin"; \
    ldd "$bin" | grep -Eo '/[^[:space:]]+' | while read -r lib; do \
      mkdir -p "/tmp/merged$(dirname "$lib")"; cp -L "$lib" "/tmp/merged$lib"; done; done; \
  mkdir -p /tmp/merged/usr/bin; \
  gcc -static -Os -Wall -Wextra -o /tmp/merged/usr/bin/hid_evdev_observer /tmp/evdev.c; \
  echo R08_COPY_KERNEL_MODULE_DEPENDENCY_CLOSURE; \
  for m in usbip_core usbip_host vhci_hcd usbip_vudc libcomposite dummy_hcd usb_f_hid usbhid hid_generic evdev e1000 virtio virtio_pci virtio_ring virtio_console; do \
    modprobe -S "$version" --show-depends "$m" | awk '$1=="insmod"{print $2}'; \
  done | sort -u | while IFS= read -r kofile; do \
    test -f "$kofile"; mkdir -p "/tmp/merged$(dirname "$kofile")"; cp -L "$kofile" "/tmp/merged$kofile"; \
  done; \
  test -d "/tmp/merged/lib/modules/$version"; \
  find "/tmp/merged/lib/modules/$version" -type f -name '*.ko*' | wc -l; \
  depmod -b /tmp/merged "$version"; \
  for role in provider consumer-a consumer-b; do cp "/tmp/$role.init" /tmp/merged/init; chmod 0755 /tmp/merged/init; \
    test -f /tmp/merged/init && test -x /tmp/merged/init; \
    ls -ld /tmp/merged/init /tmp/merged/lib /tmp/merged/lib/modules || true; \
    (cd /tmp/merged && find . -print | cpio --quiet -o -H newc | gzip -9) > "/out/$role.gz"; \
    gzip -t "/out/$role.gz"; \
    mkdir -p "/tmp/check-$role"; \
    (cd "/tmp/check-$role" && gzip -dc "/out/$role.gz" | cpio --quiet -idm); \
    test -x "/tmp/check-$role/init"; \
    test -d "/tmp/check-$role/lib/modules/$version"; \
    echo "R08_ARCHIVE_EXTRACTED_BOOT_FILES=$role"; \
  done; \
  test -s /out/provider.gz && test -s /out/consumer-a.gz && test -s /out/consumer-b.gz
# Reuse the EXACT qualified existing Go Manager and journal source from
# public PR #824 pinned by the separate checkout in this Actions job.
# Docker named build context avoids vendoring or maintaining a second broker.
COPY --from=gosource experiments/usb-fabric-r26/integrated /tmp/gosource/integrated
COPY --from=gosource experiments/usb-fabric-r26/releasegate /tmp/gosource/releasegate
COPY --from=r22source experiments/pi-usb-fabric-r22/guest-ed25519 /tmp/gosource/r22
COPY --from=pinsource experiments/pi-usb-fabric-r26/host-pin/guest-main.go /tmp/gosource/releasegate/guestwire/cmd/guest/main.go
COPY --from=pinsource experiments/pi-usb-fabric-r26/host-pin/keygen.go /tmp/r27-test-keygen.go
COPY experiments/pi-usb-fabric-r27/typed-kernel-runtime/broker.go /tmp/gosource/integrated/r18-bridge.go
RUN set -eux; \
  cd /tmp/gosource/r22 && \
  go mod edit -replace=example.org/usb-fabric-r26-releasegate=/tmp/gosource/releasegate && \
  cd /tmp/gosource/releasegate && \
  GOPROXY=off GOSUMDB=off GOTOOLCHAIN=local CGO_ENABLED=0 \
  go build -tags r22_guest -trimpath -o /out/r22-guest-observer ./guestwire/cmd/guest && \
  GO111MODULE=off go run /tmp/r27-test-keygen.go /out/r27-guest-seed.hex /out/r27-approved-public.hex && \
  test "$(wc -c < /out/r27-guest-seed.hex)" -eq 65 && \
  test "$(wc -c < /out/r27-approved-public.hex)" -eq 65 && \
  mkdir -p /tmp/r22-consumer-a && \
  cd /tmp/r22-consumer-a && gzip -dc /out/consumer-a.gz | cpio --quiet -idm && \
  mkdir -p usr/bin guest && cp /out/r22-guest-observer usr/bin/guestwire-observer && \
  cp /out/r27-guest-seed.hex guest/r26-test-ed25519-seed.hex && \
  chmod 0400 guest/r26-test-ed25519-seed.hex && \
  test -x usr/bin/guestwire-observer && \
  find . -print | LC_ALL=C cpio --quiet -o -H newc | gzip -9 > /out/consumer-a.gz && \
  gzip -t /out/consumer-a.gz && \
  cd /tmp/gosource/integrated && \
  go mod edit -require=example.org/usb-fabric-r22-guest-ed25519@v0.0.0 && \
  go mod edit -replace=example.org/usb-fabric-r22-guest-ed25519=/tmp/gosource/r22 && \
  GOPROXY=off GOSUMDB=off GOTOOLCHAIN=local CGO_ENABLED=0 \
  go build -trimpath -o /out/r18-broker ./r18-bridge.go
FROM ${BASE}
RUN apt-get update -qq && apt-get install -qq -y --no-install-recommends \
  qemu-system-x86 coreutils grep && rm -rf /var/lib/apt/lists/*
COPY --from=builder /out/r18-broker /guest/r18-broker
COPY --from=builder /out/r27-approved-public.hex /guest/r27-approved-public.hex
COPY --from=builder /out/kernel /guest/kernel
COPY --from=builder /out/provider.gz /guest/provider.gz
COPY --from=builder /out/consumer-a.gz /guest/consumer-a.gz
COPY --from=builder /out/consumer-b.gz /guest/consumer-b.gz
COPY --from=builder /out/kernel-config /guest/kernel-config
COPY experiments/pi-usb-fabric-r22/qmp-usbip-compose/usbip-guest-signing/run.sh /guest/run.sh
USER 65532:65532
ENTRYPOINT ["/bin/sh","/guest/run.sh"]
