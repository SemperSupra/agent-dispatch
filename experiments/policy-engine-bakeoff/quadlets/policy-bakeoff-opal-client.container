# Synthetic authorization RDTE. No private refs, keys or customer data.
# Linux amd64+arm64 native Podman Quadlet; distribution tags are captured at run time.
[Unit]
Description=OPAL client with inline OPA synthetic
After=policy-bakeoff-opal-server.service
Requires=policy-bakeoff-opal-server.service
[Container]
Image=docker.io/permitio/opal-client:latest
ContainerName=policy-bakeoff-opal-client
Network=policy-bakeoff.network
PublishPort=127.0.0.1:7766:7000
PublishPort=127.0.0.1:8181:8181
Environment=OPAL_SERVER_URL=http://policy-bakeoff-opal-server:7002
Environment=OPAL_INLINE_OPA_LOG_FORMAT=http
[Service]
Restart=on-failure
TimeoutStartSec=180
[Install]
WantedBy=multi-user.target
