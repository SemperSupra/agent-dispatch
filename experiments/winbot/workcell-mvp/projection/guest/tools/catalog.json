    "revula": {
      "name": "revula",
      "display_name": "Revula MCP Server",
      "description": "107-tool MCP server for universal RE automation — Frida, Ghidra, radare2, Wireshark, angr, Android RE, exploit dev. Python-based, installs as a backend MCP server inside the VM.",
      "category": "mcp_backend",
      "dependencies": ["python", "frida", "ghidra", "radare2", "wireshark", "python_re_packages"],
      "capabilities_enabled": ["mcp_revula", "dynamic_instrumentation_mcp", "static_analysis_mcp", "android_re_mcp", "protocol_analysis_mcp", "exploit_dev_mcp", "symbolic_execution_mcp"],
      "script": "install-backend-mcps.ps1",
      "verify": {
        "type": "command",
        "command": "python",
        "args": ["-c", "import revula; print('ok')"],
        "expect_exit": 0
      },
      "install_time_minutes": 5,
      "human_only": false,
      "mcp_port": 9001,
      "mcp_command": "python -m revula --port 9001",
      "_note": "Requires all RE tools pre-installed. Backend MCP managed by WinBot MCP lifecycle."
    },

    "ghidra_mcp": {
      "name": "ghidra_mcp",
      "display_name": "Ghidra MCP Server",
      "description": "249-tool MCP for Ghidra — decompilation, P-code emulation, live debugging, cross-binary docs, batch ops. Installs as Ghidra plugin + Python bridge inside the VM.",
      "category": "mcp_backend",
      "dependencies": ["java21", "ghidra", "python"],
