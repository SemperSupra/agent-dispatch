      "mcp_command": "python C:\\WinBot\\tools\\ghidra-mcp\\server.py --port 9002",
      "_note": "Cloned from github.com/bethington/ghidra-mcp. Requires Ghidra headless or GUI session."
    },

    "pyghidra_mcp": {
      "name": "pyghidra_mcp",
      "display_name": "PyGhidra MCP Server",
      "description": "Python-first Ghidra MCP — headless mode, ChromaDB vector search across decompiled functions, project-wide analysis. Python-based via pyghidra + jpype.",
      "category": "mcp_backend",
      "dependencies": ["java21", "ghidra", "python"],
      "capabilities_enabled": ["pyghidra_mcp", "semantic_code_search", "headless_decompilation", "project_wide_analysis"],
