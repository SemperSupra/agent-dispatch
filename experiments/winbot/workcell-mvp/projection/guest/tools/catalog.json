  "capability_groups": {
    "core": {
      "label": "Core Platform",
      "description": "Always available — requires no extra tools",
      "capabilities": ["screenshot", "window_management", "app_launch", "lifecycle", "health_checking"]
    },
    "python_automation": {
      "label": "Python Automation",
      "description": "Python script execution and pyautogui input/screenshot",
      "capabilities": ["run_python", "input_automation", "screenshot_capture"],
      "requires_tools": ["python", "pyautogui_packages"]
    },
    "gui_automation": {
      "label": "GUI Automation",
      "description": "AutoHotkey and AutoIt script execution for GUI control",
      "capabilities": ["run_ahk", "run_autoit", "gui_automation"],
      "requires_tools": ["ahk", "autoit"]
    },
    "static_analysis": {
      "label": "Static Analysis",
      "description": "Disassembly, decompilation, binary inspection without execution",
      "capabilities": ["static_analysis_headless", "static_analysis_cli", "binary_decompilation", "binary_analysis", "binary_detection", "packer_identification", "string_deobfuscation"],
      "requires_tools": ["ghidra", "radare2", "die", "floss"]
    },
    "dynamic_analysis": {
      "label": "Dynamic Analysis",
      "description": "Runtime instrumentation, debugging, process manipulation",
      "capabilities": ["dynamic_instrumentation", "dynamic_analysis_cli", "dynamic_debugging_gui", "process_manipulation", "remote_instrumentation"],
      "requires_tools": ["frida", "frida_server", "radare2", "x64dbg"]
    },
    "network_analysis": {
      "label": "Network Analysis",
      "description": "Packet capture, protocol analysis, traffic monitoring",
      "capabilities": ["network_capture", "protocol_analysis"],
      "requires_tools": ["wireshark"]
    },
    "system_monitoring": {
      "label": "System Monitoring",
      "description": "Process monitoring, system inspection, runtime behavior observation",
      "capabilities": ["process_monitoring", "system_inspection"],
      "requires_tools": ["sysinternals"]
    },
    "python_re_toolkit": {
      "label": "Python RE Toolkit",
      "description": "Python libraries for PE analysis, disassembly, CPU emulation, YARA scanning",
      "capabilities": ["python_re_toolkit", "pe_analysis", "disassembly", "cpu_emulation", "yara_scanning"],
      "requires_tools": ["python_re_packages"]
    },
    "remote_desktop": {
      "label": "Remote Desktop",
      "description": "Browser-embedded interactive remote desktop via noVNC + TightVNC",
      "capabilities": ["remote_desktop_vnc"],
      "requires_tools": ["tightvnc"]
    },

    "mcp_backends": {
      "label": "MCP Backends",
      "description": "Backend MCP servers (revula, ghidra-mcp, pyghidra-mcp) for AI-driven RE",
      "capabilities": ["mcp_revula", "ghidra_mcp", "pyghidra_mcp", "dynamic_instrumentation_mcp", "static_analysis_mcp", "android_re_mcp", "protocol_analysis_mcp", "exploit_dev_mcp", "symbolic_execution_mcp", "binary_decompilation_mcp", "pcode_emulation", "cross_binary_analysis", "ghidra_debugger", "semantic_code_search", "headless_decompilation", "project_wide_analysis"],
      "requires_tools": ["revula", "ghidra_mcp", "pyghidra_mcp"]
    }
  },

  "loadout_templates": {
    "winbot-core": {
      "display_name": "WinBot Core",
      "description": "Minimal WinBot platform — API service, Python automation, GUI automation, remote desktop",
      "tools": ["chocolatey", "python", "pyautogui_packages", "ahk", "autoit", "nssm", "winspy", "tightvnc"],
      "capability_groups": ["core", "python_automation", "gui_automation", "remote_desktop"]
    },
    "windows-re": {
      "display_name": "Windows RE Lab",
      "description": "Complete Windows RE environment — static + dynamic analysis, backend MCP servers for AI-driven RE",
      "tools": ["chocolatey", "python", "pyautogui_packages", "ahk", "autoit", "nssm", "winspy",
                "java21", "ghidra", "radare2", "x64dbg", "frida", "frida_server",
                "wireshark", "sysinternals", "die", "floss", "python_re_packages",
                "revula", "ghidra_mcp", "pyghidra_mcp"],
      "capability_groups": ["core", "python_automation", "gui_automation",
                            "static_analysis", "dynamic_analysis", "network_analysis",
                            "system_monitoring", "python_re_toolkit", "mcp_backends"]
    }
  }
}
